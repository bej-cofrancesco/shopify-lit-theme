{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2022", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@frontend/*": ["src/frontend/*"],
      "@entrypoints/*": ["src/frontend/entrypoints/*"],
      "@components/*": ["src/frontend/components/*"],
      "shopify-lit": ["packages/shopify-lit/src/index.ts"],
      "shopify-lit/decorators": ["packages/shopify-lit/src/decorators.ts"],
      "shopify-lit/vite": ["packages/shopify-lit/vite/index.ts"],
      "shopify-lit/*": ["packages/shopify-lit/src/*"],
      "vite-plugin-tailwind-content-reload": [
        "packages/vite-plugin-tailwind-content-reload/src/index.ts"
      ],
      "@/*": ["src/frontend/*"],
      "~/*": ["src/frontend/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/frontend/**/*",
    "packages/**/*",
    "vite/**/*",
    "vite.config.ts",
    "vite-env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
