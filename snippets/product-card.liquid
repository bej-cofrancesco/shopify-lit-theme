{% comment %}
  AUTO-GENERATED from product-card.ts by shopify-lit
  Do not edit by hand.
{% endcomment %}
{% assign on = on | default: 'visible' %}
{% if product != blank %}
{% capture props %}
  {
    "url": {{ product.url | json }},
    "title": {{ product.title | json }},
    "vendor": {{ product.vendor | json }},
    "price": {{ product.price | json }},
    "media": {{ product.media | json }},
    "size": {{ size | default: 'sm' | json }}
  }
{% endcapture %}
{% if skip_script %}
<product-card data-lit-ssr props="{{ props | escape }}">
<article class="group flex w-full flex-col">
        <a
          class="relative block w-full overflow-hidden bg-gray-100 pt-[125%]"
          href="{{ product.url }}"
        >
          {% for media in product.media limit: 2 %}
            <img
              class="absolute inset-0 h-full w-full object-cover opacity-0 first:opacity-100 group-has-[img:nth-child(2)]:group-hover:first:opacity-0 [&:nth-child(n+2)]:group-hover:opacity-100"
              src="{{ media.preview_image | image_url: width: 800 }}"
              alt="{{ media.alt }}"
              width="400"
              height="500"
              loading="lazy"
              decoding="async"
            />
          {% endfor %}
        </a>
        <div class="mt-2 flex flex-col gap-0.5">
          <h3 class="truncate text-sm font-medium text-gray-900">
            <a class="hover:underline" href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <p class="text-sm text-gray-600">{{ product.price | money }}</p>
          <button
            type="button"
            class="mt-1 self-start text-3xs tracking-2 uppercase text-gray-500 transition-colors hover:text-black disabled:opacity-40"
            
            aria-label="Add to cart"
            data-lit-on-click="onAdd"
          >
            Add to cart
          </button>
        </div>
      </article>
</product-card>
{% else %}
{% capture island_html %}
<product-card data-lit-ssr props="{{ props | escape }}">
<article class="group flex w-full flex-col">
        <a
          class="relative block w-full overflow-hidden bg-gray-100 pt-[125%]"
          href="{{ product.url }}"
        >
          {% for media in product.media limit: 2 %}
            <img
              class="absolute inset-0 h-full w-full object-cover opacity-0 first:opacity-100 group-has-[img:nth-child(2)]:group-hover:first:opacity-0 [&:nth-child(n+2)]:group-hover:opacity-100"
              src="{{ media.preview_image | image_url: width: 800 }}"
              alt="{{ media.alt }}"
              width="400"
              height="500"
              loading="lazy"
              decoding="async"
            />
          {% endfor %}
        </a>
        <div class="mt-2 flex flex-col gap-0.5">
          <h3 class="truncate text-sm font-medium text-gray-900">
            <a class="hover:underline" href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <p class="text-sm text-gray-600">{{ product.price | money }}</p>
          <button
            type="button"
            class="mt-1 self-start text-3xs tracking-2 uppercase text-gray-500 transition-colors hover:text-black disabled:opacity-40"
            
            aria-label="Add to cart"
            data-lit-on-click="onAdd"
          >
            Add to cart
          </button>
        </div>
      </article>
</product-card>
{% endcapture %}
{% render 'vulpine-loader',
  entry: '@components/product-card.ts',
  on: on,
  replay: replay,
  html: island_html
%}
{% endif %}
{% endif %}
