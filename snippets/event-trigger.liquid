{% comment %}
  AUTO-GENERATED from event-trigger.ts by shopify-lit
  Do not edit by hand.
{% endcomment %}
{% assign on = on | default: 'visible' %}
{% capture props %}
  {
    "event": {{ event | json }},
    "detail": {{ detail | json }},
    "html": {{ html | json }},
    "label": {{ label | json }}
  }
{% endcapture %}
{% if skip_script %}
<event-trigger data-lit-ssr props="{{ props | escape }}">
<button
        type="button"
        class="inline-flex appearance-none border-0 bg-transparent p-0"
        aria-label="{{ label }}"
        data-lit-on-click="onActivate"
      >
        {{ html }}
      </button>
</event-trigger>
{% else %}
{% capture island_html %}
<event-trigger data-lit-ssr props="{{ props | escape }}">
<button
        type="button"
        class="inline-flex appearance-none border-0 bg-transparent p-0"
        aria-label="{{ label }}"
        data-lit-on-click="onActivate"
      >
        {{ html }}
      </button>
</event-trigger>
{% endcapture %}
{% render 'vulpine-loader',
  entry: '@components/event-trigger.ts',
  on: on,
  replay: replay,
  html: island_html
%}
{% endif %}
