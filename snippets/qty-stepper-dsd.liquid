{% doc %}
  Declarative Shadow DOM host for qty-stepper.
  Keep this markup identical to QtyStepper.render() in frontend/components/qty-stepper.ts
  (same tags, classes, attribute order). That is the 1:1 contract — no SSR codegen.

  @param {number} [value] - Initial quantity (default 1)
  @param {number} [min] - Minimum (default 1)
  @param {number} [max] - Maximum (default 9)
{% enddoc %}
{% liquid
  assign value = value | default: 1
  assign min = min | default: 1
  assign max = max | default: 9
  assign at_min = false
  assign at_max = false
  if value <= min
    assign at_min = true
  endif
  if value >= max
    assign at_max = true
  endif
%}
<qty-stepper value="{{ value }}" min="{{ min }}" max="{{ max }}">
  <template shadowrootmode="open">
    {% comment %} First paint before Lit; BoilerplateElement inlines the same theme CSS after hydrate {% endcomment %}
    {% render 'vite', entry: 'theme.css' %}
    <div
      class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white p-2 shadow-sm"
      role="group"
      aria-label="Quantity"
    >
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg bg-stone-100 text-lg font-medium text-stone-800 hover:bg-stone-200 disabled:cursor-not-allowed disabled:opacity-40"
        {% if at_min %}
          disabled
        {% endif %}
        aria-label="Decrease"
      >
        −
      </button>
      <span
        class="min-w-10 text-center text-base font-semibold tabular-nums text-stone-900"
        data-qty-value
      >
        {{ value }}
      </span>
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg bg-stone-900 text-lg font-medium text-white hover:bg-stone-800 disabled:cursor-not-allowed disabled:opacity-40"
        {% if at_max %}
          disabled
        {% endif %}
        aria-label="Increase"
      >
        +
      </button>
    </div>
  </template>
</qty-stepper>
