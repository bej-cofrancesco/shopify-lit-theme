                    </li>
                  {% endfor %}{% endif %}
        </ul>
      </div>
</carousel-arrows>
{% endcapture %}
{% render 'vulpine-loader',
  entry: '@components/carousel-arrows.ts',
  on: on,
  replay: replay,
  html: island_html
%}
{% endif %}
