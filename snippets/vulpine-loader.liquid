{% doc %}
  Defers loading a Vite entry until a trigger fires. Host markup paints immediately.

  For on: interaction, the click/key that triggered load is replayed after hydrate
  so drawers/modals/buttons still perform their action (opt out with replay: false).

  @param {string} entry - Vite entry path, e.g. '@components/qty-stepper.ts'
  @param {string} [on] - visible | idle | interaction (default: visible)
  @param {boolean} [replay] - Replay the triggering event after load (default true)
  @param {string} html - Host markup to wrap (usually captured CE + DSD)
{% enddoc %}
<vulpine-loader
  on="{{ on | default: 'visible' }}"
  {% if replay == false or replay == 'false' %}
    replay="false"
  {% endif %}
>
  <template data-vulpine-scripts>
    {% render 'vite', entry: entry %}
  </template>
  {{ html }}
</vulpine-loader>
