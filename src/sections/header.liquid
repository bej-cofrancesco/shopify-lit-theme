<header class="border-b border-stone-200 bg-white">
  <div class="container mx-auto flex items-center justify-between gap-4 px-4 py-4">
    <a href="{{ routes.root_url }}" class="text-lg font-semibold tracking-tight">
      {{ shop.name }}
    </a>
    <nav class="flex items-center gap-4 text-sm" aria-label="Primary">
      <a class="hover:underline" href="{{ routes.root_url }}">Home</a>
      <a class="hover:underline" href="{{ routes.cart_url }}">Cart</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": []
}
{% endschema %}
