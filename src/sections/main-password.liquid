<section class="mx-auto max-w-md py-16 text-center">
  <h1 class="text-2xl font-semibold">{{ shop.name }}</h1>
  <p class="mt-4 text-stone-600">This store is password protected.</p>
  {% form 'storefront_password', class: 'mt-6 space-y-3' %}
    {{ form.errors | default_errors }}
    <input
      class="w-full rounded border border-stone-300 px-3 py-2"
      type="password"
      name="password"
      placeholder="Password"
    >
    <button class="w-full rounded bg-stone-900 px-4 py-2 text-white" type="submit">Enter</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "settings": []
}
{% endschema %}
