{%- comment -%}
  Markup returned by /search/suggest?section_id=predictive_search
  Product tiles match the idle search-drawer carousel layout.
{%- endcomment -%}

{%- liquid
  assign item_classes = 'w-[calc((100%+1rem)/3.35-4px)] shrink-0 snap-start md:w-[calc(100%/3.35-4px)]'
  assign heading_classes = 'text-3xs leading-sm tracking-2 font-bold uppercase text-gray-400'
  assign row_classes = 'group -mx-2 flex w-[calc(100%+1rem)] items-center justify-between gap-2 px-2 py-1.5 text-left text-sm text-gray-600 transition-colors hover:bg-gray-50 hover:text-black'

  assign has_products = false
  if predictive_search.resources.products.size > 0
    assign has_products = true
  endif

  assign has_aside = false
  if predictive_search.resources.collections.size > 0 or predictive_search.resources.queries.size > 0
    assign has_aside = true
  endif
-%}

<div
  class="flex flex-col gap-7 md:grid md:grid-cols-[minmax(0,1fr)_240px] md:items-start md:gap-10"
  data-predictive-search
>
  {%- if has_products -%}
    {%- capture results_track -%}
      {%- for product in predictive_search.resources.products -%}
        <li class="{{ item_classes }}">
          {% render 'product-card', product: product, size: 'sm', skip_script: true %}
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="{% if has_aside %}block{% else %}block md:col-span-2{% endif %}">
      {% render 'carousel-arrows',
        title: 'Products',
        html: results_track,
        skip_script: true
      %}
    </div>
  {%- endif -%}

  {%- if has_aside -%}
    <div
      class="{% if has_products %}border-t border-gray-100 pt-6 {% endif %}flex flex-col gap-6 md:border-t-0 md:pt-0"
    >
      {%- if predictive_search.resources.queries.size > 0 -%}
        <div class="flex flex-col gap-2">
          <h3 class="{{ heading_classes }}">Suggestions</h3>
          <ul class="flex flex-col">
            {%- for query in predictive_search.resources.queries -%}
              <li>
                <a
                  href="{{ query.url }}"
                  data-search-term="{{ query.text | escape }}"
                  class="{{ row_classes }}"
                >
                  <span>{{ query.styled_text }}</span>
                  <span
                    class="text-gray-400 transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                    >&rsaquo;</span
                  >
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if predictive_search.resources.collections.size > 0 -%}
        <div class="flex flex-col gap-2">
          <h3 class="{{ heading_classes }}">Collections</h3>
          <ul class="flex flex-col">
            {%- for collection in predictive_search.resources.collections -%}
              <li>
                <a
                  href="{{ collection.url }}"
                  data-search-term="{{ collection.title | escape }}"
                  class="{{ row_classes }}"
                >
                  <span>{{ collection.title }}</span>
                  <span
                    class="text-gray-400 transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                    >&rsaquo;</span
                  >
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- unless has_products or has_aside -%}
    <p class="text-sm text-gray-500 md:col-span-2">No results found</p>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
