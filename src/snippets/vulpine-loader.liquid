{% doc %}
  Defers loading a Vite entry until a trigger fires. Host markup paints immediately.

  `on` accepts one or more triggers (space / comma / + separated). All are armed;
  the first to fire wins.

  Triggers:
  - visible | idle | interaction
  - event:<name> — load when that event fires on window (e.g. event:search:open).
    After hydrate, the **exact same event** (type + detail) is re-dispatched.
  - media:<query> — gate; other triggers only arm while matchMedia matches
    (e.g. media:(max-width: 767px) event:search:open)

  Example: `on: 'idle visible'` or `on: 'event:search:open idle'`

  @param {string} entry - Vite entry path, e.g. '@components/my-island.ts'
  @param {string} [on] - trigger list (default: visible)
  @param {boolean} [replay] - Replay the triggering event after load (default true)
  @param {string} html - Host markup to wrap (usually captured CE + DSD)
{% enddoc %}
<vulpine-loader
  on="{{ on | default: 'visible' }}"
  {% if replay == false or replay == 'false' %}
    replay="false"
  {% endif %}
>
  <template data-vulpine-scripts>
    {% render 'vite', entry: entry %}
  </template>
  {{ html }}
</vulpine-loader>
