<section class="space-y-16">
  <header class="space-y-3">
    <h1 class="text-3xl font-semibold tracking-tight">{{ 'dsd.title' | t }}</h1>
    <p class="max-w-2xl text-stone-600">{{ 'dsd.intro' | t }}</p>
    <p class="text-sm text-stone-500">
      Use the search icon in the header — the drawer loads on
      <code class="text-xs">search:open</code> (or idle).
    </p>
  </header>

  <div class="space-y-3">
    <h2 class="text-xl font-medium">{{ 'dsd.product_card_heading' | t }}</h2>
    <p class="text-sm text-stone-500">{{ 'dsd.product_card_hint' | t }}</p>
    {% liquid
      assign product_collection = section.settings.collection
      if product_collection == blank
        assign product_collection = collections.all
      endif
      assign products_to_show = section.settings.products_to_show | default: 4
    %}
    {% if product_collection.products_count > 0 %}
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" role="list">
        {% for product in product_collection.products limit: products_to_show %}
          <li>
            {% render 'product-card', product: product, on: 'visible' %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="text-sm text-stone-500">{{ 'dsd.product_card_empty' | t }}</p>
    {% endif %}
  </div>

  <p class="text-sm font-medium text-stone-500">{{ 'dsd.scroll_spacer' | t }}</p>
  <div class="h-[70vh] rounded-xl border border-dashed border-stone-300 bg-stone-50" aria-hidden="true"></div>

  <div class="space-y-3">
    <h2 class="text-xl font-medium">{{ 'dsd.visible_heading' | t }}</h2>
    <p class="text-sm text-stone-500">{{ 'dsd.visible_hint' | t }}</p>
    {% render 'qty-stepper', value: 5, min: 1, max: 9, on: 'idle visible' %}
  </div>

  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-4 text-sm text-stone-600">
    {{ 'dsd.no_js_note' | t }}
  </p>
</section>

{% schema %}
{
  "name": "t:sections.main.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.main.settings.collection.label",
      "info": "t:sections.main.settings.collection.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.main.settings.products_to_show.label"
    }
  ]
}
{% endschema %}
