<section class="space-y-10">
  <header class="space-y-3">
    <h1 class="text-3xl font-semibold tracking-tight">{{ 'dsd.title' | t }}</h1>
    <p class="max-w-2xl text-stone-600">{{ 'dsd.intro' | t }}</p>
  </header>

  <div class="space-y-3">
    <h2 class="text-xl font-medium">{{ 'dsd.interaction_heading' | t }}</h2>
    <p class="text-sm text-stone-500">{{ 'dsd.interaction_hint' | t }}</p>
    {% capture stepper %}
      {% render 'qty-stepper-dsd', value: 3, min: 1, max: 9 %}
    {% endcapture %}
    {% render 'vulpine-loader',
      entry: '@components/qty-stepper.ts',
      on: 'interaction',
      content: stepper
    %}
  </div>

  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-4 text-sm text-stone-600">
    {{ 'dsd.no_js_note' | t }}
  </p>
</section>

{% schema %}
{
  "name": "t:sections.main.name",
  "settings": []
}
{% endschema %}
