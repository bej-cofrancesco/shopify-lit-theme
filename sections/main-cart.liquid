<section>
  <h1 class="text-2xl font-semibold">Cart</h1>
  {% if cart.item_count == 0 %}
    <p class="mt-4 text-stone-600">Your cart is empty.</p>
  {% else %}
    <ul class="mt-4 space-y-2">
      {% for item in cart.items %}
        <li>{{ item.product.title }} × {{ item.quantity }}</li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.main-cart.name",
  "settings": []
}
{% endschema %}
