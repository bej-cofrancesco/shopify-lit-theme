<section>
  <h1 class="text-2xl font-semibold">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-4 flex gap-2">
    <input
      class="w-full rounded border border-stone-300 px-3 py-2"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Search"
    >
    <button class="rounded bg-stone-900 px-4 py-2 text-white" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <ul class="mt-6 space-y-2">
      {% for item in search.results %}
        <li>
          <a class="hover:underline" href="{{ item.url }}">{{ item.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "settings": []
}
{% endschema %}
